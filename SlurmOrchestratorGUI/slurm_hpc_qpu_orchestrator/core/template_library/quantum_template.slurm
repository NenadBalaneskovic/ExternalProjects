export QISKIT_RUNTIME_API_KEY="{{API_KEY}}"
export QISKIT_RUNTIME_URL="{{RUNTIME_URL}}"

# ----------------------------------------------------------------------
# Run quantum Python workflow
# ----------------------------------------------------------------------
python {{SCRIPT_NAME}}
